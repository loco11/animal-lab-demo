{
  "name": "animal-lab-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "校级实验室业务管理平台 管理端静态演示（原生 TS，无 UI 框架）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build && node scripts/inline.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  }
}
